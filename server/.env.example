# Postgres connection string used by the Prisma driver adapter (lib/prisma.js)
DATABASE_URL=
# Single allowed CORS origin — app.js throws at import time if this is unset
CLIENT_URL=
# Secret used to sign and verify JWTs; Render generates this in production
JWT_SECRET=
# OpenAI key for services/openai.js — also throws at import time if unset
OPENAI_API_KEY=
# "production" in deployed environments; controls the winston log level
NODE_ENV=
# Optional comma-separated keys for middleware/authorize.js apiKeyAuth
API_KEYS=
